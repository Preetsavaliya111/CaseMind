CASEMIND_QDRANT_ENV_FILE=/secure/casemind/qdrant.env
CASEMIND_POSTGRES_PASSWORD_FILE=/secure/casemind/postgres-password
BACKEND_IMAGE=casemind-backend:local
FRONTEND_IMAGE=casemind-frontend:local
